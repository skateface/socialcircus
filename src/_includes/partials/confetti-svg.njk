{# Decorative confetti scatter, purely visual, hidden from assistive tech. #}
<div class="confetti-scatter" aria-hidden="true">
  <svg class="confetti-piece confetti-piece--1" width="16" height="16" viewBox="0 0 16 16"><rect width="16" height="16" rx="3" fill="var(--color-gold)"/></svg>
  <svg class="confetti-piece confetti-piece--2" width="14" height="14" viewBox="0 0 16 16"><circle cx="8" cy="8" r="8" fill="var(--color-teal)"/></svg>
  <svg class="confetti-piece confetti-piece--3" width="18" height="18" viewBox="0 0 16 16"><rect width="16" height="16" rx="3" fill="var(--color-purple)"/></svg>
  <svg class="confetti-piece confetti-piece--4" width="12" height="12" viewBox="0 0 16 16"><circle cx="8" cy="8" r="8" fill="var(--color-red)"/></svg>
  <svg class="confetti-piece confetti-piece--5" width="16" height="16" viewBox="0 0 16 16"><rect width="16" height="16" rx="3" fill="var(--color-white)"/></svg>
  <svg class="confetti-piece confetti-piece--6" width="14" height="14" viewBox="0 0 16 16"><circle cx="8" cy="8" r="8" fill="var(--color-gold)"/></svg>
</div>
